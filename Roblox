local function setTabActive(btn, frame)
	local tabButtons = {flyTabBtn, speedTabBtn, jumpTabBtn, infoTabBtn}

	for _, tab in ipairs(tabButtons) do
		tab.TextColor3 = Color3.fromRGB(145, 145, 155)
		tab.BackgroundColor3 = Color3.fromRGB(25, 26, 32)
		tab.ActiveBar.Visible = false
	end

	FlyFrame.Visible = false
	SpeedFrame.Visible = false
	InfoFrame.Visible = false
	JumpFrame.Visible = false

	btn.TextColor3 = Color3.fromRGB(95, 185, 255)
	btn.BackgroundColor3 = Color3.fromRGB(34, 43, 55)
	btn.ActiveBar.Visible = true
	frame.Visible = true
end

